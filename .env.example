# Copiar nombres a Netlify → Site settings → Environment variables.
# Dejar los valores vacíos aquí. No pegar secretos en el repo.
# Lista y efecto de cada una: docs/netlify-env.md

# Login de servidor (sin estas, el patio sigue con el kardex en el navegador)
PATIO_SESSION_SECRET=
PATIO_SPREADSHEET_ID=
# Una vía: cuenta de servicio
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
# La otra vía: Apps Script (si las dos existen, gana la cuenta de servicio)
PATIO_APPS_SCRIPT_URL=
PATIO_APPS_SCRIPT_SECRET=
PATIO_GOOGLE_CLIENT_ID=
PATIO_GOOGLE_HOSTED_DOMAIN=
PATIO_SESSION_TTL_SEC=
PATIO_ALLOWED_ORIGIN=
PATIO_DRIVE_FOLDER_ID=

# WhatsApp Cloud API. Sin las dos, el aviso queda solo en AvisosLog.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
AVISOS_WHATSAPP_TO=

# Correo (SendGrid o SMTP). Una de las dos basta.
SENDGRID_API_KEY=
SENDGRID_FROM=
SMTP=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_SECURE=
AVISOS_EMAIL_TO=
SMTP_TO=
AVISOS_CRON_SECRET=
PARADO_AGING_HORAS=

# Frotcom. Sin URL y token, la conciliación responde en seco y no escribe.
FROTCOM_API_URL=
FROTCOM_TOKEN=
PATIO_GEOCERCAS_JSON=
PATIO_INTEGRATION_KEY=

# OCR y Grok. Sin llave, la captura de placa y ¿Dudas? siguen en manual.
GOOGLE_VISION_API_KEY=
GCP_VISION_API_KEY=
XAI_API_KEY=
GROK_API_KEY=
XAI_MODEL=
GROK_MODEL=
